// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  ONGOING
  UPCOMING
  COMPLETED
}

enum ItemType {
  TRANSPORT
  STAY
  ACTIVITY
  MEAL
  OTHER
}

model User {
  id                   String          @id @default(uuid())
  firstName            String
  lastName             String
  email                String          @unique
  password             String
  phoneNumber          String?
  photoUrl             String?
  city                 String?
  country              String?
  languagePreference   String          @default("en")
  role                 Role            @default(USER)
  isActive             Boolean         @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  refreshTokens        RefreshToken[]
  trips                Trip[]
  savedCities          UserSavedCity[]
  communityPosts       CommunityPost[]
  postLikes            PostLike[]
  postComments         PostComment[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model City {
  id               String            @id @default(uuid())
  name             String
  state            String            @default("Gujarat")
  country          String            @default("India")
  region           String            @default("Western India")
  costIndex        Int               @default(3)
  popularityScore  Int               @default(80)
  bannerImageUrl   String?
  description      String?
  isTopRegional    Boolean           @default(true)
  createdAt        DateTime          @default(now())
  savedByUsers     UserSavedCity[]
  tripSections     TripSection[]
  activities       Activity[]
  sectionTemplates SectionTemplate[]
  tripTemplates    TripTemplate[]
  communityPosts   CommunityPost[]

  @@index([state])
  @@index([region])
  @@index([isTopRegional])
  @@index([popularityScore])
}

model UserSavedCity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cityId])
  @@index([userId])
}

model TripTemplate {
  id              String   @id @default(uuid())
  cityId          String?
  city            City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  title           String
  description     String   @db.Text
  coverPhotoUrl   String
  durationDays    Int      @default(3)
  estimatedBudget Decimal  @default(0.0) @db.Decimal(10, 2)
  state           String
  templateData    Json
  createdAt       DateTime @default(now())

  @@index([state])
}

model Trip {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  coverPhotoUrl  String?
  startDate      DateTime
  endDate        DateTime
  status         TripStatus      @default(UPCOMING)
  totalBudget    Decimal         @default(0.0) @db.Decimal(12, 2)
  isPublic       Boolean         @default(false)
  shareableSlug  String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sections       TripSection[]
  communityPosts CommunityPost[]

  @@index([userId])
  @@index([status])
  @@index([startDate])
}

model TripSection {
  id              String          @id @default(uuid())
  tripId          String
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId          String?
  city            City?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  sectionTitle    String
  startDate       DateTime
  endDate         DateTime
  budgetAllocated Decimal         @default(0.0) @db.Decimal(12, 2)
  description     String?
  orderIndex      Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           ItineraryItem[]

  @@index([tripId])
  @@index([orderIndex])
}

model Activity {
  id                String          @id @default(uuid())
  cityId            String
  city              City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  imageUrl          String?
  type              String          @default("Activity")
  estimatedCost     Decimal         @default(0.0) @db.Decimal(12, 2)
  estimatedDuration String?
  durationHours     Float           @default(2.0)
  popularityScore   Int             @default(85)
  createdAt         DateTime        @default(now())
  itineraryItems    ItineraryItem[]
  templateItems     TemplateItem[]

  @@index([cityId])
  @@index([type])
  @@index([popularityScore])
}

model ItineraryItem {
  id         String      @id @default(uuid())
  sectionId  String
  section    TripSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  dayNumber  Int         @default(1)
  itemDate   DateTime?
  title      String
  type       ItemType    @default(ACTIVITY)
  startTime  String?
  endTime    String?
  cost       Decimal     @default(0.0) @db.Decimal(12, 2)
  orderIndex Int         @default(1)
  notes      String?
  imageUrl   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([sectionId])
  @@index([orderIndex])
}

model SectionTemplate {
  id              String         @id @default(uuid())
  cityId          String
  city            City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationDays    Int            @default(2)
  suggestedBudget Decimal        @default(0.0) @db.Decimal(12, 2)
  coverImageUrl   String?
  popularityScore Int            @default(0)
  createdAt       DateTime       @default(now())
  templateItems   TemplateItem[]

  @@index([cityId])
  @@index([popularityScore])
}

model TemplateItem {
  id            String          @id @default(uuid())
  templateId    String
  template      SectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  activityId    String?
  activity      Activity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  title         String
  type          ItemType        @default(ACTIVITY)
  dayOffset     Int             @default(1)
  startTime     String?
  endTime       String?
  estimatedCost Decimal         @default(0.0) @db.Decimal(12, 2)
  orderIndex    Int             @default(1)
  notes         String?

  @@index([templateId])
  @@index([orderIndex])
}

model CommunityPost {
  id            String        @id @default(uuid())
  userId        String
  tripId        String?
  cityId        String?
  title         String
  content       String        @db.Text
  category      String?
  images        String[]      @default([])
  likesCount    Int           @default(0)
  commentsCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip          Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  city          City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  likes         PostLike[]
  comments      PostComment[]

  @@index([userId])
  @@index([cityId])
  @@index([category])
  @@index([createdAt])
  @@index([likesCount])
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  content   String        @db.Text
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}
